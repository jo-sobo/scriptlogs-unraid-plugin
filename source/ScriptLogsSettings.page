<?php
require_once '/usr/local/emhttp/plugins/dynamix/include/Helpers.php';
require_once '/usr/local/emhttp/plugins/scriptlogs/scriptlogs_common.php';

$plugin_name = 'scriptlogs';
$cfg_file = "/boot/config/plugins/{$plugin_name}/{$plugin_name}.cfg";
$default_cfg = scriptlogs_default_cfg();
$csrf_token = htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES, 'UTF-8');

function scriptlogs_escape_cfg_value($value)
{
    $value = (string)$value;
    $value = preg_replace('/[\x00-\x1F\x7F]/', '', $value);
    if (!is_string($value)) {
        $value = '';
    }

    return str_replace(['\\', '"'], ['\\\\', '\\"'], $value);
}

function scriptlogs_write_cfg($path, $cfg)
{
    $lines = [];
    foreach ($cfg as $key => $value) {
        $safe_key = preg_replace('/[^A-Z0-9_]/', '', (string)$key);
        if (!is_string($safe_key) || $safe_key === '') {
            continue;
        }
        $lines[] = $safe_key . '="' . scriptlogs_escape_cfg_value($value) . '"';
    }

    $payload = implode("\n", $lines) . "\n";
    $dir = dirname($path);
    if (!is_dir($dir) && !@mkdir($dir, 0755, true)) {
        return false;
    }

    $tmp_path = @tempnam($dir, basename($path) . '.tmp.');
    if (!is_string($tmp_path) || $tmp_path === '') {
        return false;
    }

    $written = @file_put_contents($tmp_path, $payload, LOCK_EX);
    if ($written === false || !@rename($tmp_path, $path)) {
        @unlink($tmp_path);
        return false;
    }

    return true;
}

$user_scripts_path = '/boot/config/plugins/user.scripts/scripts';
$available_scripts = [];
if (is_dir($user_scripts_path)) {
    $scripts = array_diff(scandir($user_scripts_path), ['.', '..']);
    foreach ($scripts as $script_name) {
        if (is_dir("{$user_scripts_path}/{$script_name}")) {
            $available_scripts[] = $script_name;
        }
    }
}
sort($available_scripts, SORT_NATURAL | SORT_FLAG_CASE);

$cfg = scriptlogs_read_cfg($plugin_name);
$scriptlogs_theme_light = scriptlogs_theme_is_light();

$save_error = '';

if (isset($_POST['#apply'])) {
    $refresh_enabled = (isset($_POST['REFRESH_ENABLED']) && $_POST['REFRESH_ENABLED'] === '0') ? '0' : '1';
    $refresh_interval_input = isset($_POST['REFRESH_INTERVAL']) ? trim((string)$_POST['REFRESH_INTERVAL']) : $default_cfg['REFRESH_INTERVAL'];
    $refresh_interval = ctype_digit($refresh_interval_input) ? (int)$refresh_interval_input : 10;
    if ($refresh_interval < 1) {
        $refresh_interval = 1;
    } elseif ($refresh_interval > 86400) {
        $refresh_interval = 86400;
    }

    $show_idle_logs = isset($_POST['SHOW_IDLE_LOGS']) ? '1' : '0';
    $remove_empty_log_lines = isset($_POST['REMOVE_EMPTY_LOG_LINES']) ? '1' : '0';

    $allowed_font_sizes = scriptlogs_allowed_font_sizes();
    $log_font_size = isset($_POST['LOG_FONT_SIZE']) ? (string)$_POST['LOG_FONT_SIZE'] : $default_cfg['LOG_FONT_SIZE'];
    if (!in_array($log_font_size, $allowed_font_sizes, true)) {
        $log_font_size = $default_cfg['LOG_FONT_SIZE'];
    }

    $requested_scripts = isset($_POST['ENABLED_SCRIPTS']) && is_array($_POST['ENABLED_SCRIPTS'])
        ? $_POST['ENABLED_SCRIPTS']
        : [];
    $requested_order = isset($_POST['SCRIPT_ORDER']) && is_array($_POST['SCRIPT_ORDER'])
        ? $_POST['SCRIPT_ORDER']
        : $available_scripts;

    $allowed_scripts = array_fill_keys($available_scripts, true);
    $checked_scripts = array_fill_keys(scriptlogs_normalize_script_list($requested_scripts), true);
    $selected_scripts = [];
    $selected_seen = [];
    foreach ($requested_order as $script_name) {
        $script_name = trim((string)$script_name);
        if (
            $script_name === ''
            || !isset($allowed_scripts[$script_name])
            || !isset($checked_scripts[$script_name])
            || isset($selected_seen[$script_name])
        ) {
            continue;
        }
        $selected_seen[$script_name] = true;
        $selected_scripts[] = $script_name;
    }
    foreach ($requested_scripts as $script_name) {
        $script_name = trim((string)$script_name);
        if ($script_name === '' || !isset($allowed_scripts[$script_name]) || isset($selected_seen[$script_name])) {
            continue;
        }
        $selected_seen[$script_name] = true;
        $selected_scripts[] = $script_name;
    }

    $new_cfg = [
        'REFRESH_ENABLED' => $refresh_enabled,
        'REFRESH_INTERVAL' => (string)$refresh_interval,
        'ENABLED_SCRIPTS' => scriptlogs_encode_enabled_scripts($selected_scripts),
        'SHOW_IDLE_LOGS' => $show_idle_logs,
        'LOG_FONT_SIZE' => $log_font_size,
        'REMOVE_EMPTY_LOG_LINES' => $remove_empty_log_lines
    ];

    if (scriptlogs_write_cfg($cfg_file, $new_cfg)) {
        $cfg = array_merge($default_cfg, $new_cfg);
    } else {
        $save_error = 'Unable to save settings.';
    }
}

$enabled_scripts_array = scriptlogs_parse_enabled_scripts($cfg['ENABLED_SCRIPTS'] ?? '');
$ordered_available_scripts = scriptlogs_order_available_scripts($available_scripts, $enabled_scripts_array);
$enabled_script_lookup = array_fill_keys($enabled_scripts_array, true);
$selected_script_count = 0;
foreach ($ordered_available_scripts as $script) {
    if (isset($enabled_script_lookup[$script])) {
        $selected_script_count++;
    }
}
