<script type="text/javascript">
  /* global jQuery */
  (function($) {
    function scriptlogs_get_drag_after_element(container, y) {
      var rows = Array.prototype.slice.call(container.querySelectorAll('.scriptlogs-script-row:not(.is-dragging)'));
      return rows.reduce(function(closest, row) {
        var box = row.getBoundingClientRect();
        var offset = y - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) {
          return { offset: offset, element: row };
        }
        return closest;
      }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
    }

    function scriptlogs_move_script_row(row, direction) {
      if (!row) return;

      if (direction === 'up' && row.previousElementSibling) {
        row.parentNode.insertBefore(row, row.previousElementSibling);
        row.focus();
      }

      if (direction === 'down' && row.nextElementSibling) {
        row.parentNode.insertBefore(row.nextElementSibling, row);
        row.focus();
      }
    }

    var scriptlogs_armed_drag_row = null;

    function scriptlogs_enable_row_drag(row) {
      if (!row) return;

      scriptlogs_armed_drag_row = row;
      row.setAttribute('draggable', 'true');
      row.classList.add('scriptlogs-row-draggable');
    }

    function scriptlogs_disable_row_drag(row) {
      if (!row) return;

      row.removeAttribute('draggable');
      row.classList.remove('scriptlogs-row-draggable');
      if (scriptlogs_armed_drag_row === row) {
        scriptlogs_armed_drag_row = null;
      }
    }

    function scriptlogs_bind_script_ordering() {
      var list = document.getElementById('scriptlogs-script-list');
      if (!list) return;

      var selectedCount = document.getElementById('scriptlogs-selected-count');
      var draggedRow = null;

      function scriptlogs_rows() {
        return Array.prototype.slice.call(list.querySelectorAll('.scriptlogs-script-row'));
      }

      function scriptlogs_refresh_selected_count() {
        if (!selectedCount) return;

        var selected = scriptlogs_rows().filter(function(row) {
          var checkbox = row.querySelector('.scriptlogs-row-check');
          return checkbox && checkbox.checked;
        }).length;
        selectedCount.textContent = selected + ' selected';
      }

      list.addEventListener('pointerdown', function(event) {
        var handle = event.target.closest('.scriptlogs-drag-handle');
        if (!handle) return;

        scriptlogs_enable_row_drag(handle.closest('.scriptlogs-script-row'));
      });

      list.addEventListener('mousedown', function(event) {
        var handle = event.target.closest('.scriptlogs-drag-handle');
        if (!handle) return;

        scriptlogs_enable_row_drag(handle.closest('.scriptlogs-script-row'));
      });

      list.addEventListener('dragstart', function(event) {
        var row = event.target.closest('.scriptlogs-script-row');
        if (!row || (row !== scriptlogs_armed_drag_row && !event.target.closest('.scriptlogs-drag-handle'))) {
          event.preventDefault();
          return;
        }

        draggedRow = row;
        row.classList.add('is-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', row.getAttribute('data-script-name') || '');
      });

      list.addEventListener('dragover', function(event) {
        if (!draggedRow) return;
        event.preventDefault();

        var afterElement = scriptlogs_get_drag_after_element(list, event.clientY);
        if (afterElement) {
          list.insertBefore(draggedRow, afterElement);
        } else {
          list.appendChild(draggedRow);
        }
      });

      list.addEventListener('dragend', function() {
        if (draggedRow) {
          draggedRow.classList.remove('is-dragging');
          scriptlogs_disable_row_drag(draggedRow);
        }
        draggedRow = null;
      });

      list.addEventListener('drop', function(event) {
        event.preventDefault();
        if (draggedRow) {
          scriptlogs_disable_row_drag(draggedRow);
        }
      });

      list.addEventListener('pointerup', function() {
        if (!draggedRow && scriptlogs_armed_drag_row) {
          scriptlogs_disable_row_drag(scriptlogs_armed_drag_row);
        }
      });

      list.addEventListener('mouseup', function() {
        if (!draggedRow && scriptlogs_armed_drag_row) {
          scriptlogs_disable_row_drag(scriptlogs_armed_drag_row);
        }
      });

      list.addEventListener('change', function(event) {
        if (!event.target.classList.contains('scriptlogs-row-check')) return;

        var row = event.target.closest('.scriptlogs-script-row');
        if (row) {
          row.classList.toggle('is-enabled', event.target.checked);
        }
        scriptlogs_refresh_selected_count();
      });

      list.addEventListener('click', function(event) {
        var button = event.target.closest('.scriptlogs-move-script');
        if (!button) return;

        var row = button.closest('.scriptlogs-script-row');
        scriptlogs_move_script_row(row, button.getAttribute('data-direction'));
      });

      scriptlogs_refresh_selected_count();
    }

    $(scriptlogs_bind_script_ordering);
  })(jQuery);
</script>
