</style>

<script type="text/javascript">
    /* global $ */
    var enabledScripts = <?=$enabled_scripts_js?>;
    var refreshEnabled = <?=json_encode($refresh_enabled)?>;
    var refreshInterval = <?=json_encode($refresh_interval_ms)?>;

    function scriptlogs_build_chips(scripts) {
        var chips = $('#scriptlogs-chips');
        chips.empty();
        (scripts || []).forEach(function(script) {
            var isRunning = script.status === 'running';
            var chip = $('<div>').addClass('scriptlogs-chip').toggleClass('sl-running', isRunning);
            $('<span>').addClass('sl-dot').appendTo(chip);
            $('<span>').text(script.name).appendTo(chip);
            chips.append(chip);
        });
    }

    function scriptlogs_scroll_log_to_bottom(logEl) {
        if (!logEl) return;
        logEl.scrollTop = logEl.scrollHeight;
    }

    function scriptlogs_is_tab_in_view(tabEl, containerEl) {
        if (!tabEl || !containerEl) return false;

        var tabRect = tabEl.getBoundingClientRect();
        var containerRect = containerEl.getBoundingClientRect();
        return tabRect.left >= containerRect.left && tabRect.right <= containerRect.right;
    }

    function scriptlogs_restore_tab_scroll(tabBar, previousScrollLeft, previouslySelected, wasSelectedVisible) {
        tabBar.scrollLeft(previousScrollLeft);

        var selectedTab = tabBar.find('.scriptlogs-tab.sl-selected');
        if (selectedTab.length === 0) return;

        var selectedEl = selectedTab[0];
        if (!selectedEl.scrollIntoView) return;

        var selectedName = selectedTab.data('script-name');
        const selectionChanged = !previouslySelected || selectedName !== previouslySelected;
        var nowOffScreen = !scriptlogs_is_tab_in_view(selectedEl, tabBar[0]);

        if (selectionChanged || (wasSelectedVisible && nowOffScreen)) {
            selectedEl.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
    }

    function scriptlogs_get_tab_scroll_metrics(tabScrollbar) {
        var maxScroll = tabScrollbar.scrollWidth - tabScrollbar.clientWidth;
        var trackWidth = tabScrollbar.clientWidth;
        var thumbWidth = maxScroll > 0
            ? Math.min(Math.max((tabScrollbar.clientWidth / tabScrollbar.scrollWidth) * trackWidth, 24), trackWidth)
            : trackWidth;
        var maxThumbLeft = Math.max(trackWidth - thumbWidth, 0);
        var thumbLeft = maxScroll > 0
            ? (tabScrollbar.scrollLeft / maxScroll) * maxThumbLeft
            : 0;

        return {
            maxScroll: maxScroll,
            trackWidth: trackWidth,
            thumbWidth: thumbWidth,
            maxThumbLeft: maxThumbLeft,
            thumbLeft: thumbLeft
        };
    }

    function scriptlogs_update_tab_edge_fades() {
        var tabShell = document.getElementById('scriptlogs-tab-shell');
        var tabBar = document.getElementById('scriptlogs-tab-bar');
        if (!tabShell || !tabBar) return;

        var maxScroll = tabBar.scrollWidth - tabBar.clientWidth;
        var hasLeftOverflow = tabBar.scrollLeft > 1;
        var hasRightOverflow = maxScroll - tabBar.scrollLeft > 1;

        tabShell.classList.toggle('has-tab-overflow', maxScroll > 1);
        tabShell.classList.toggle('has-left-overflow', hasLeftOverflow);
        tabShell.classList.toggle('has-right-overflow', hasRightOverflow);
    }

    function scriptlogs_sync_tab_scrollbar() {
        var tabBar = document.getElementById('scriptlogs-tab-bar');
        var tabScrollbar = document.getElementById('scriptlogs-tab-scrollbar');
        var tabScrollbarSpacer = document.getElementById('scriptlogs-tab-scrollbar-spacer');
        var tabScrollbarThumb = document.getElementById('scriptlogs-tab-scrollbar-thumb');
        if (!tabBar || !tabScrollbar || !tabScrollbarSpacer || !tabScrollbarThumb) return;

        tabScrollbarSpacer.style.width = tabBar.scrollWidth + 'px';
        tabScrollbar.scrollLeft = tabBar.scrollLeft;

        var metrics = scriptlogs_get_tab_scroll_metrics(tabScrollbar);
        tabScrollbarThumb.style.left = metrics.thumbLeft + 'px';
        tabScrollbarThumb.style.width = metrics.thumbWidth + 'px';

        scriptlogs_update_tab_edge_fades();
    }

    function scriptlogs_bind_tab_scrollbar() {
        var tabBar = document.getElementById('scriptlogs-tab-bar');
        var tabScrollbar = document.getElementById('scriptlogs-tab-scrollbar');
        var tabScrollbarVisual = document.getElementById('scriptlogs-tab-scrollbar-visual');
        var tabScrollbarShell = document.getElementById('scriptlogs-tab-scrollbar-shell');
        if (!tabBar || !tabScrollbar || !tabScrollbarVisual || !tabScrollbarShell) return;

        var isDraggingThumb = false;
        var dragStartX = 0;
        var dragStartScrollLeft = 0;

        tabScrollbar.addEventListener('scroll', function() {
            tabBar.scrollLeft = tabScrollbar.scrollLeft;
            scriptlogs_sync_tab_scrollbar();
        });

        tabBar.addEventListener('scroll', function() {
            tabScrollbar.scrollLeft = tabBar.scrollLeft;
            scriptlogs_sync_tab_scrollbar();
        });

        tabScrollbarVisual.addEventListener('pointerdown', function(event) {
            var metrics = scriptlogs_get_tab_scroll_metrics(tabScrollbar);
            if (metrics.maxScroll <= 0 || metrics.maxThumbLeft <= 0) return;

            var rect = tabScrollbarVisual.getBoundingClientRect();
            var clickX = event.clientX - rect.left;

            if (clickX < metrics.thumbLeft || clickX > metrics.thumbLeft + metrics.thumbWidth) {
                var centeredLeft = Math.min(
                    Math.max(clickX - metrics.thumbWidth / 2, 0),
                    metrics.maxThumbLeft
                );
                tabScrollbar.scrollLeft = (centeredLeft / metrics.maxThumbLeft) * metrics.maxScroll;
            }

            isDraggingThumb = true;
            tabScrollbarShell.classList.add('is-dragging');
            dragStartX = event.clientX;
            dragStartScrollLeft = tabScrollbar.scrollLeft;
            if (tabScrollbarVisual.setPointerCapture) {
                tabScrollbarVisual.setPointerCapture(event.pointerId);
            }
        });

        tabScrollbarVisual.addEventListener('pointermove', function(event) {
            if (!isDraggingThumb) return;

            var metrics = scriptlogs_get_tab_scroll_metrics(tabScrollbar);
            if (metrics.maxScroll <= 0 || metrics.maxThumbLeft <= 0) return;

            var deltaX = event.clientX - dragStartX;
            tabScrollbar.scrollLeft = dragStartScrollLeft + (deltaX / metrics.maxThumbLeft) * metrics.maxScroll;
        });

        function stopDrag(event) {
            isDraggingThumb = false;
            tabScrollbarShell.classList.remove('is-dragging');
            if (event && tabScrollbarVisual.releasePointerCapture) {
                tabScrollbarVisual.releasePointerCapture(event.pointerId);
            }
        }

        tabScrollbarVisual.addEventListener('pointerup', stopDrag);
        tabScrollbarVisual.addEventListener('pointercancel', stopDrag);
        tabScrollbarVisual.addEventListener('lostpointercapture', stopDrag);
        window.addEventListener('resize', scriptlogs_sync_tab_scrollbar);
    }

    function scriptlogs_status() {
        if (!enabledScripts || enabledScripts.length === 0) {
            $('#scriptlogs-logs').text('No scripts selected. Please check your Scriptlogs settings.');
            $('#scriptlogs-tab-bar').empty();
            scriptlogs_sync_tab_scrollbar();
            return;
        }

        $.getJSON('/plugins/scriptlogs/scriptlogs_api.php?action=get_script_states', function(scripts) {
            const tabBar     = $('#scriptlogs-tab-bar');
            const logBox     = $('#scriptlogs-log-box');
            const logDisplay = $('#scriptlogs-logs');
            const logEl      = logBox[0];
            const timestamp  = $('#scriptlogs-timestamp');

            const previouslySelected = tabBar.find('.sl-selected').data('script-name');
            const previousScrollLeft = tabBar.scrollLeft();
            const prevSelectedEl = tabBar.find('.scriptlogs-tab.sl-selected')[0];
            const wasSelectedVisible = prevSelectedEl ? scriptlogs_is_tab_in_view(prevSelectedEl, tabBar[0]) : false;
            const previousSelectedLog = logDisplay.text();

            tabBar.empty();

            if (!scripts || !Array.isArray(scripts) || scripts.length === 0) {
                logDisplay.text('No scripts selected to display.');
                timestamp.text(new Date().toLocaleTimeString());
                scriptlogs_sync_tab_scrollbar();
                return;
            }

            scripts.forEach(function(script) {
                var isRunning = script.status === 'running';

                var tab = $('<div>')
                    .addClass('scriptlogs-tab')
                    .toggleClass('sl-running', isRunning)
                    .data('script-name', script.name)
                    .data('log-content', script.log);

                $('<span>').addClass('scriptlogs-tab-running-mark').appendTo(tab);
                $('<span>').addClass('scriptlogs-tab-label').text(script.name).appendTo(tab);
                $('<span>').addClass('scriptlogs-tab-selected-mark').appendTo(tab);

                tab.on('click', function() {
                    tabBar.find('.scriptlogs-tab').removeClass('sl-selected');
                    $(this).addClass('sl-selected');
                    logDisplay.text($(this).data('log-content'));
                    if ($('#scriptlogs-autoscroll').is(':checked')) {
                        scriptlogs_scroll_log_to_bottom(logEl);
                    }
                });

                tabBar.append(tab);
            });

            scriptlogs_build_chips(scripts);

            var selectedTab = tabBar.find('.scriptlogs-tab').filter(function() {
                return $(this).data('script-name') === previouslySelected;
            });

            if (selectedTab.length > 0) {
                selectedTab.addClass('sl-selected');
                var activeScript = scripts.find(function(s) { return s.name === previouslySelected; });
                if (activeScript) {
                    logDisplay.text(activeScript.log);
                    if (activeScript.log !== previousSelectedLog && $('#scriptlogs-autoscroll').is(':checked')) {
                        scriptlogs_scroll_log_to_bottom(logEl);
                    }
                }
            } else {
                tabBar.find('.scriptlogs-tab').first().trigger('click');
            }

            scriptlogs_restore_tab_scroll(tabBar, previousScrollLeft, previouslySelected, wasSelectedVisible);
            scriptlogs_sync_tab_scrollbar();

            timestamp.text(new Date().toLocaleTimeString());
        }).fail(function(jqXHR, textStatus, errorThrown) {
            console.error("Scriptlogs AJAX Error:", textStatus, errorThrown);
            $('#scriptlogs-logs').text('Error loading script states. Check browser console (F12) for details.');
        });
    }

    // Watch for Unraid's openClose toggling the content row, and swap in/out chips row
    function scriptlogs_watch_collapse() {
        var contentRow = document.getElementById('scriptlogs-content-row');
        var collapsedRow = document.getElementById('scriptlogs-collapsed-row');
        if (!contentRow || !collapsedRow) return;

        var observer = new MutationObserver(function() {
            var isCollapsed = contentRow.style.display === 'none' || contentRow.hidden;
            collapsedRow.style.display = isCollapsed ? '' : 'none';
        });

        observer.observe(contentRow, { attributes: true, attributeFilter: ['style', 'hidden'] });
    }

    $(function() {
        $('#scriptlogs-autoscroll').on('change', function() {
            if ($(this).is(':checked')) {
                scriptlogs_scroll_log_to_bottom(document.getElementById('scriptlogs-log-box'));
            }
        });

        scriptlogs_bind_tab_scrollbar();
        scriptlogs_status();
        scriptlogs_watch_collapse();

        if (refreshEnabled && refreshInterval > 0) {
            setInterval(scriptlogs_status, refreshInterval);
        }
    });
</script>
