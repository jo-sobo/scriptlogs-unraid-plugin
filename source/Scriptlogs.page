        <td>
            <div id="scriptlogs-tab-shell">
                <div id="scriptlogs-tab-scrollbar-shell">
                    <div id="scriptlogs-tab-scrollbar-visual" aria-hidden="true">
                        <div id="scriptlogs-tab-scrollbar-thumb"></div>
                    </div>
                    <div id="scriptlogs-tab-scrollbar" aria-hidden="true">
                        <div id="scriptlogs-tab-scrollbar-spacer"></div>
