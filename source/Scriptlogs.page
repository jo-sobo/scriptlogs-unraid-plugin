<?php
require_once '/usr/local/emhttp/plugins/dynamix/include/Helpers.php';
require_once '/usr/local/emhttp/plugins/scriptlogs/scriptlogs_common.php';

$cfg = parse_plugin_cfg('scriptlogs', true);
if (!is_array($cfg)) {
    $cfg = [];
}

$enabled_scripts = scriptlogs_parse_enabled_scripts($cfg['ENABLED_SCRIPTS'] ?? '');
$enabled_scripts_js = json_encode($enabled_scripts);
if (!is_string($enabled_scripts_js)) {
    $enabled_scripts_js = '[]';
}

$refresh_enabled = ($cfg['REFRESH_ENABLED'] ?? '1') === '1';
$refresh_interval = (int)($cfg['REFRESH_INTERVAL'] ?? 10);
if ($refresh_interval < 1) {
    $refresh_interval = 1;
}
$refresh_interval_ms = $refresh_interval * 1000;

$allowed_font_sizes = ['0.75rem', '0.875rem', '1rem', '1.125rem', '1.25rem'];
$log_font_size = $cfg['LOG_FONT_SIZE'] ?? '1rem';
if (!in_array($log_font_size, $allowed_font_sizes, true)) {
    $log_font_size = '1rem';
}
$log_font_size = htmlspecialchars($log_font_size, ENT_QUOTES, 'UTF-8');

$pluginname = 'scriptlogs';

$mytiles[$pluginname]['column1'] = <<<EOT
