<?php
require_once '/usr/local/emhttp/plugins/dynamix/include/Helpers.php';

function scriptlogs_normalize_script_list($items)
{
    if (!is_array($items)) {
        return [];
    }

    $normalized = [];
    $seen = [];
    foreach ($items as $item) {
        $name = trim((string)$item);
        if ($name === '' || isset($seen[$name])) {
            continue;
        }
        $seen[$name] = true;
        $normalized[] = $name;
    }

    return $normalized;
}

function scriptlogs_parse_enabled_scripts($rawValue)
{
    $rawValue = is_string($rawValue) ? trim($rawValue) : '';
    if ($rawValue === '') {
        return [];
    }

    if (strpos($rawValue, 'json:') === 0) {
        $encoded = substr($rawValue, 5);
        if ($encoded !== '') {
            $decodedJson = base64_decode($encoded, true);
            if (is_string($decodedJson) && $decodedJson !== '') {
                $decoded = json_decode($decodedJson, true);
                if (is_array($decoded)) {
                    return scriptlogs_normalize_script_list($decoded);
                }
            }
        }
    }

    return scriptlogs_normalize_script_list(explode(',', $rawValue));
}

$cfg = parse_plugin_cfg('scriptlogs', true);
if (!is_array($cfg)) {
    $cfg = [];
}

$enabled_scripts = scriptlogs_parse_enabled_scripts($cfg['ENABLED_SCRIPTS'] ?? '');
$enabled_scripts_js = json_encode($enabled_scripts);
if (!is_string($enabled_scripts_js)) {
    $enabled_scripts_js = '[]';
}

$refresh_enabled = ($cfg['REFRESH_ENABLED'] ?? '1') === '1';
$refresh_interval = (int)($cfg['REFRESH_INTERVAL'] ?? 10);
if ($refresh_interval < 1) {
    $refresh_interval = 1;
}
$refresh_interval_ms = $refresh_interval * 1000;

$allowed_font_sizes = ['0.75rem', '0.875rem', '1rem', '1.125rem', '1.25rem'];
$log_font_size = $cfg['LOG_FONT_SIZE'] ?? '1rem';
if (!in_array($log_font_size, $allowed_font_sizes, true)) {
    $log_font_size = '1rem';
}
$log_font_size = htmlspecialchars($log_font_size, ENT_QUOTES, 'UTF-8');

$pluginname = 'scriptlogs';

$mytiles[$pluginname]['column1'] = <<<EOT
<tbody id="db-scriptlogs" title="Script Logs">
    <tr>
        <td>
            <i class="fa fa-fw fa-close control tile" onclick="dismiss($(this))" title="Close Tile"></i>
            <span class="tile-header">
                <span class="tile-header-left">
                    <i class="fa fa-terminal fa-lg"></i>
                    <div class="section">
                        <h3 class="tile-header-main">Script Logs</h3>
                    </div>
                </span>
                <span class="tile-header-right">
                    <span class="tile-header-right-controls">
                        <a href="/Settings/ScriptlogsSettings" title="Scriptlogs Settings">
                            <i class="fa fa-fw fa-cog control"></i>
                        </a>
                    </span>
                </span>
            </span>
        </td>
    </tr>
    <tr id="scriptlogs-collapsed-row" style="display:none;">
        <td>
            <div id="scriptlogs-chips"></div>
        </td>
    </tr>
    <tr id="scriptlogs-content-row">
        <td>
            <div id="scriptlogs-tab-bar"></div>
            <div id="scriptlogs-log-box">
                <pre id="scriptlogs-logs">Select a script to see its log.</pre>
            </div>
            <div id="scriptlogs-footer">
                <label><input type="checkbox" id="scriptlogs-autoscroll" checked> Auto-scroll</label>
                <span>Last Update: <span id="scriptlogs-timestamp"></span></span>
            </div>
        </td>
    </tr>
</tbody>
EOT;
?>

<style>
#scriptlogs-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding: 6px 0;
}
.scriptlogs-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    padding: 3px 8px;
    border: 1px solid #444;
    color: #999;
    background: #222;
    white-space: nowrap;
}
.scriptlogs-chip .sl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    background: #555;
}
.scriptlogs-chip.sl-running {
    border-color: #3a6b3a;
    color: #ccc;
}
.scriptlogs-chip.sl-running .sl-dot {
    background: #4CAF50;
}
#scriptlogs-tab-bar {
    display: flex;
    flex-direction: row;
    padding-top: 10px;
    width: 0;
    min-width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: #555 transparent;
}
#scriptlogs-tab-bar::-webkit-scrollbar {
    height: 6px;
}
#scriptlogs-tab-bar::-webkit-scrollbar-track {
    background: transparent;
}
#scriptlogs-tab-bar::-webkit-scrollbar-thumb {
    background: #555;
    border-radius: 3px;
}
.scriptlogs-tab {
    padding: 7px 14px;
    font-size: 14.4px;
    font-weight: bold;
    color: #999;
    cursor: pointer;
    border: 1px solid #555;
    border-bottom: none;
    background: #222;
    user-select: none;
    white-space: nowrap;
    position: relative;
    flex: 0 0 auto;
}
.scriptlogs-tab + .scriptlogs-tab {
    border-left: none;
}
.scriptlogs-tab.sl-running {
    border-top: 3px solid #4CAF50;
}
.scriptlogs-tab.sl-selected {
    background: #1a1a1a;
    color: #eee;
}
.scriptlogs-tab.sl-selected::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(to right, #e52f29, #fd8830);
}
#scriptlogs-log-box {
    border: 1px solid #555;
    margin-top: 2px;
    background: #1a1a1a;
    height: 200px;
    min-width: min(360px, 100%);
    overflow-y: auto;
    overflow-x: hidden;
}
#scriptlogs-logs {
    margin: 0;
    padding: 8px;
    color: #e0e0e0;
    font-family: monospace;
    font-size: <?= $log_font_size ?>;
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: break-all;
    width: 100%;
    box-sizing: border-box;
    border: none;
    background: transparent;
}
#scriptlogs-footer {
    margin-top: 5px;
    font-size: 10px;
    color: #888;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
#scriptlogs-footer label {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    color: #888;
}
</style>

<script type="text/javascript">
    /* global $ */
    var enabledScripts = <?=$enabled_scripts_js?>;
    var refreshEnabled = <?=json_encode($refresh_enabled)?>;
    var refreshInterval = <?=json_encode($refresh_interval_ms)?>;

    function scriptlogs_build_chips(scripts) {
        var chips = $('#scriptlogs-chips');
        chips.empty();
        (scripts || []).forEach(function(script) {
            var isRunning = script.status === 'running';
            var chip = $('<div>').addClass('scriptlogs-chip').toggleClass('sl-running', isRunning);
            $('<span>').addClass('sl-dot').appendTo(chip);
            $('<span>').text(script.name).appendTo(chip);
            chips.append(chip);
        });
    }

    function scriptlogs_is_tab_in_view(tabEl, containerEl) {
        if (!tabEl || !containerEl) return false;

        var tabRect = tabEl.getBoundingClientRect();
        var containerRect = containerEl.getBoundingClientRect();
        return tabRect.left >= containerRect.left && tabRect.right <= containerRect.right;
    }

    function scriptlogs_restore_tab_scroll(tabBar, previousScrollLeft, previouslySelected, wasSelectedVisible) {
        tabBar.scrollLeft(previousScrollLeft);

        var selectedTab = tabBar.find('.scriptlogs-tab.sl-selected');
        if (selectedTab.length === 0) return;

        var selectedEl = selectedTab[0];
        if (!selectedEl.scrollIntoView) return;

        var selectedName = selectedTab.data('script-name');
        const selectionChanged = !previouslySelected || selectedName !== previouslySelected;
        var nowOffScreen = !scriptlogs_is_tab_in_view(selectedEl, tabBar[0]);

        if (selectionChanged || (wasSelectedVisible && nowOffScreen)) {
            selectedEl.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
    }

    function scriptlogs_status() {
        if (!enabledScripts || enabledScripts.length === 0) {
            $('#scriptlogs-logs').text('No scripts selected. Please check your Scriptlogs settings.');
            $('#scriptlogs-tab-bar').empty();
            return;
        }

        $.getJSON('/plugins/scriptlogs/scriptlogs_api.php?action=get_script_states', function(scripts) {
            const tabBar     = $('#scriptlogs-tab-bar');
            const logBox     = $('#scriptlogs-log-box');
            const logDisplay = $('#scriptlogs-logs');
            const logEl      = logBox[0];
            const timestamp  = $('#scriptlogs-timestamp');

            const previouslySelected = tabBar.find('.sl-selected').data('script-name');
            const previousScrollLeft = tabBar.scrollLeft();
            const prevSelectedEl = tabBar.find('.scriptlogs-tab.sl-selected')[0];
            const wasSelectedVisible = prevSelectedEl ? scriptlogs_is_tab_in_view(prevSelectedEl, tabBar[0]) : false;
            const isScrolledToBottom = logEl.scrollHeight - Math.ceil(logEl.scrollTop) - logEl.clientHeight <= 1;

            tabBar.empty();

            if (!scripts || !Array.isArray(scripts) || scripts.length === 0) {
                logDisplay.text('No scripts selected to display.');
                timestamp.text(new Date().toLocaleTimeString());
                return;
            }

            scripts.forEach(function(script) {
                var isRunning = script.status === 'running';

                var tab = $('<div>')
                    .addClass('scriptlogs-tab')
                    .toggleClass('sl-running', isRunning)
                    .text(script.name)
                    .data('script-name', script.name)
                    .data('log-content', script.log);

                tab.on('click', function() {
                    tabBar.find('.scriptlogs-tab').removeClass('sl-selected');
                    $(this).addClass('sl-selected');
                    logDisplay.text($(this).data('log-content'));
                    if ($('#scriptlogs-autoscroll').is(':checked')) {
                        logEl.scrollTop = logEl.scrollHeight;
                    }
                });

                tabBar.append(tab);
            });

            // Update chips for collapsed view
            scriptlogs_build_chips(scripts);

            // Restore selected tab or pick first
            var selectedTab = tabBar.find('.scriptlogs-tab').filter(function() {
                return $(this).data('script-name') === previouslySelected;
            });

            if (selectedTab.length > 0) {
                selectedTab.addClass('sl-selected');
                var activeScript = scripts.find(function(s) { return s.name === previouslySelected; });
                if (activeScript) {
                    logDisplay.text(activeScript.log);
                }
            } else {
                tabBar.find('.scriptlogs-tab').first().trigger('click');
            }

            scriptlogs_restore_tab_scroll(tabBar, previousScrollLeft, previouslySelected, wasSelectedVisible);

            if ($('#scriptlogs-autoscroll').is(':checked') && isScrolledToBottom) {
                logEl.scrollTop = logEl.scrollHeight;
            }

            timestamp.text(new Date().toLocaleTimeString());
        }).fail(function(jqXHR, textStatus, errorThrown) {
            console.error("Scriptlogs AJAX Error:", textStatus, errorThrown);
            $('#scriptlogs-logs').text('Error loading script states. Check browser console (F12) for details.');
        });
    }

    // Watch for Unraid's openClose toggling the content row, and swap in/out chips row
    function scriptlogs_watch_collapse() {
        var contentRow = document.getElementById('scriptlogs-content-row');
        var collapsedRow = document.getElementById('scriptlogs-collapsed-row');
        if (!contentRow || !collapsedRow) return;

        var observer = new MutationObserver(function() {
            var isCollapsed = contentRow.style.display === 'none' || contentRow.hidden;
            collapsedRow.style.display = isCollapsed ? '' : 'none';
        });

        observer.observe(contentRow, { attributes: true, attributeFilter: ['style', 'hidden'] });
    }

    $(function() {
        scriptlogs_status();
        scriptlogs_watch_collapse();

        if (refreshEnabled && refreshInterval > 0) {
            setInterval(scriptlogs_status, refreshInterval);
        }
    });
</script>
